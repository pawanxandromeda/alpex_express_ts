// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  
}

generator client {
  provider = "prisma-client-js"
}

enum Status {
  Active
  Inactive
}

enum ShiftType {
  Day
  Night
  Rotational
}

enum TodoPriority {
  Low
  Medium
  High
  Urgent
}

enum TodoStatus {
  Open
  InProgress
  OnHold
  Completed
  Cancelled
}

enum LeadStatus {
  New
  Contacted
  Interested
  Qualified
  Converted
  Lost
  OnHold
}

enum FollowUpStatus {
  Pending
  Completed
  Rescheduled
}

enum EmployeeStatus {
  Pending
  Active
  Inactive
}

enum CredentialApprovalStatus {
  Pending
  Approved
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
  Cancelled
}

enum LeaveType {
  Sick
  Casual
  Earned
  Maternity
  Paternity
  Unpaid
  Special
  Bereavement
  Marriage
  Study
}

enum AttendanceStatus {
  Present
  Absent
  Leave
  HalfDay
  WFH
  Holidays
  WeekOff
}

enum PayrollStatus {
  Draft
  Submitted
  Approved
  Processed
  Paid
  Rejected
}

enum PerformanceRating {
  Outstanding
  Exceeds
  Meets
  Developing
  Unsatisfactory
}

enum GrievanceStatus {
  Filed
  UnderReview
  InProgress
  Resolved
  Closed
  Withdrawn
}

enum DocumentType {
  Aadhar
  PAN
  DrivingLicense
  Passport
  EducationCertificate
  ExperienceCertificate
  MedicalReport
  Other
}

enum ProformaInvoiceStatus {
  Draft
  Sent
  Verified
  Rejected
  Converted
}

model Employee {
  id                     String                   @id @default(uuid())
  name                   String
  email                  String?                   @unique
  phone                  String                   @unique
  role                   String
  department             String
  status                 EmployeeStatus           @default(Pending)
  approvedForCredentials CredentialApprovalStatus @default(Pending)

  dateOfJoining          DateTime?
  dateOfBirth            DateTime?
  ctc                    Float?
  baseSalary             Float?
  fatherName             String?
  motherName             String?
  spouseName             String?
  permanentAddress       String?
  currentAddress         String?
  bloodGroup             String?
  emergencyContact       String?
  emergencyContactPhone  String?
  
  // HR Extended Fields
  designation            String?
  reportingManagerId     String?
  reportingManager       Employee?  @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates           Employee[] @relation("ReportingManager")
  bankName               String?
  bankAccountNumber      String?
  bankIfscCode           String?
  panNumber              String?
  aadharNumber           String?
  esi                    String?
  pf                     String?
  totalLeaveBalance      Int?       @default(0)
  usedLeave              Int?       @default(0)
  
  createdByRole          String
  username               String?                  @unique
  password               String?
  approvedBy             String?
  approvedAt             DateTime?
  rejectionReason        String?
  refreshToken           String?

  createdTodos           Todo[]                   @relation("CreatedTodos")
  assignedTodos          Todo[]                   @relation("AssignedTodos")
  mentionedInTodos       TodoMention[]            @relation("MentionedEmployee")
  assignedLeads          Lead[]                   @relation("AssignedLeads")
  adminAssignedLeads     Lead[]                   @relation("AdminAssignedLeads")
  leadFollowUps          LeadFollowUp[]           @relation("LeadFollowUps")
  
  // Customer Assignment Relations
  createdCustomers       Customer[]               @relation("CustomerCreatedBy")
  assignedCustomers      Customer[]               @relation("CustomerAssignedTo")
  customerAssignmentsByMe CustomerAssignmentHistory[] @relation("CustomerAssignedBy")

  // Purchase Order Assignment Relations
  assignedPurchaseOrders PurchaseOrder[]          @relation("PurchaseOrderAssignedTo")
  poAssignmentsByMe      PurchaseOrderAssignmentHistory[] @relation("PurchaseOrderAssignedBy")
  
  // HR Relations
  leaveRequests          LeaveRequest[]           @relation("EmployeeLeaveRequests")
  approverLeaveRequests  LeaveRequest[]           @relation("ApproverLeaveRequests")
  attendanceRecords      Attendance[]
  payrollRecords         Payroll[]
  documents              EmployeeDocument[]
  performanceReviews     PerformanceReview[]      @relation("RevieweePerformance")
  givenReviews           PerformanceReview[]      @relation("ReviewerPerformance")
  employeeBenefits       EmployeeBenefit[]
  grievances             Grievance[]              @relation("EmployeeGrievance")
  grievanceAssignedTo    Grievance[]              @relation("AssignedToGrievance")
  shifts                 EmployeeShift[]
  trainingPrograms       EmployeeTraining[]
  
  // Security Relations
  loginAttempts          LoginAttempt[]           @relation("LoginAttempts")
  accountLockouts        AccountLockout[]         @relation("AccountLockouts")
  securityAuditLogs      SecurityAuditLog[]       @relation("SecurityAuditLogs")
  navbarPermissions      NavbarPermission?        @relation("NavbarPermissions")

  // Proforma Invoice Approval Relations
  piPreparedBy           ProformaInvoice[]        @relation("PI_PreparedBy")
  piCheckedBy            ProformaInvoice[]        @relation("PI_CheckedBy")
  piAccountant           ProformaInvoice[]        @relation("PI_Accountant")
  piDesigner             ProformaInvoice[]        @relation("PI_Designer")
  piAuthorisedBy         ProformaInvoice[]        @relation("PI_AuthorisedBy")

  // Maintenance Module Relations
  maintenanceMachineAssignedTo Machine[]           @relation("MaintenanceMachineAssignedTo")
  maintenanceRecordAssignedTo  MaintenanceRecord[] @relation("MaintenanceRecordAssignedTo")
  fixedAssetAssignedTo         FixedAsset[]        @relation("FixedAssetAssignedTo")

  // Master Password Relations
  masterPasswordsCreated MasterPassword[]         @relation("MasterPasswordCreatedBy")
  masterPasswordsUpdated MasterPassword[]         @relation("MasterPasswordUpdatedBy")
  masterPasswordUsageLogs MasterPasswordUsageLog[] @relation("MasterPasswordUsedBy")

  // Login Access Control
  canLogin               Boolean                  @default(true)

  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  
  @@index([department])
  @@index([status])
  @@index([reportingManagerId])
}

model MasterPassword {
  id                      String                    @id @default(uuid())
  passwordHash            String
  createdByEmployeeId     String
  createdByEmployee       Employee                  @relation("MasterPasswordCreatedBy", fields: [createdByEmployeeId], references: [id])
  updatedByEmployeeId     String?
  updatedByEmployee       Employee?                 @relation("MasterPasswordUpdatedBy", fields: [updatedByEmployeeId], references: [id])
  lastUsedAt              DateTime?
  numberOfUses            Int                       @default(0)
  lastUsedByEmployeeId    String?
  isActive                Boolean                   @default(true)
  usageLogs               MasterPasswordUsageLog[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([createdByEmployeeId])
  @@index([updatedByEmployeeId])
  @@index([isActive])
}

model MasterPasswordUsageLog {
  id                       String          @id @default(uuid())
  masterPasswordId         String
  masterPassword           MasterPassword  @relation(fields: [masterPasswordId], references: [id], onDelete: Cascade)
  usedByEmployeeId         String
  usedByEmployee           Employee        @relation("MasterPasswordUsedBy", fields: [usedByEmployeeId], references: [id])
  accessedEmployeeId       String?
  accessedEmployeeName     String?
  action                   String          // LOGIN, CREATE, UPDATE, etc.
  ipAddress                String?
  userAgent                String?
  reason                   String?
  accessGranted            Boolean         @default(true)
  failureReason            String?
  metadata                 Json?
  createdAt                DateTime        @default(now())

  @@index([masterPasswordId])
  @@index([usedByEmployeeId])
  @@index([accessedEmployeeId])
  @@index([createdAt])
  @@index([action])
}

model Customer {
  id                   String   @id @default(uuid())
  customerName         String
  address              String?
  creditLimit          Float    @default(0)
  creditApprovalStatus String   @default("Pending")
  paymentTerms         String
  throughVia           String?
  gstrNo               String   @unique
  createdByEmployeeId  String?
  createdByEmployee    Employee? @relation("CustomerCreatedBy", fields: [createdByEmployeeId], references: [id])
  assignedToEmployeeId String?
  assignedToEmployee   Employee? @relation("CustomerAssignedTo", fields: [assignedToEmployeeId], references: [id])
  assignedAt           DateTime?
  kycProfile           String?
  contactName          String?
  contactPhone         String?
  contactEmail         String?
  contacts             Json?
  remarks              String?
  relationshipStatus   String?
  gstCopy              String?
  drugLicense         String?   // License number (string)
  dlExpiry             DateTime? // Expiry date (DateTime)
  isBlacklisted        Boolean  @default(false)
  blacklistReason      String?
  promotor             String?
  blacklistedAt        DateTime?
  purchaseOrders       PurchaseOrder[]
  proformaInvoices     ProformaInvoice[]
  leads                Lead[]
  annualTurnover       String?
  assignmentHistory    CustomerAssignmentHistory[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CustomerAssignmentHistory {
  id                   String   @id @default(uuid())
  customerId           String
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedToEmployeeId String?
  assignedByEmployeeId String
  assignedByEmployee   Employee @relation("CustomerAssignedBy", fields: [assignedByEmployeeId], references: [id])
  previousEmployeeId   String?
  reason               String?
  remarks              String?
  assignedAt           DateTime @default(now())

  @@index([customerId])
  @@index([assignedToEmployeeId])
  @@index([assignedAt])
}

model Lead {
  id                   String      @id @default(uuid())
  customerId           String
  customer             Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedToEmployeeId String?
  assignedToEmployee   Employee?   @relation("AssignedLeads", fields: [assignedToEmployeeId], references: [id])
  assignedByEmployeeId String
  assignedByEmployee   Employee    @relation("AdminAssignedLeads", fields: [assignedByEmployeeId], references: [id])
  status               LeadStatus  @default(New)
  followUps            LeadFollowUp[]
  notes                String?
  assignedAt           DateTime    @default(now())
  lastContactedAt      DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  assignmentHistory    LeadAssignmentHistory[]
  @@unique([customerId, assignedToEmployeeId])
}

model LeadAssignmentHistory {
  id                   String   @id @default(uuid())
  leadId               String
  lead                 Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToEmployeeId String?
  assignedByEmployeeId String
  assignedAt           DateTime @default(now())
  notes                String?
}

model LeadFollowUp {
  id                   String     @id @default(uuid())
  leadId               String
  lead                 Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee   @relation("LeadFollowUps", fields: [employeeId], references: [id])
  followUpType         String     // e.g., "Call", "Email", "Meeting", "Demo"
  notes                String?
  nextFollowUpDate     DateTime?
  status               FollowUpStatus @default(Pending)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Todo {
  id                String       @id @default(uuid())
  title             String
  description       String?
  priority          TodoPriority @default(Medium)
  status            TodoStatus   @default(Open)
  createdById       String
  createdBy         Employee     @relation("CreatedTodos", fields: [createdById], references: [id], onDelete: Cascade)
  assignedToId      String?
  assignedTo        Employee?    @relation("AssignedTodos", fields: [assignedToId], references: [id], onDelete: SetNull)
  mentionedEmployees TodoMention[] @relation("TodoMentions")
  updates           TodoUpdate[] @relation("TodoUpdates")
  completed         Boolean      @default(false)
  completedAt       DateTime?
  dueDate           DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([createdById])
  @@index([assignedToId])
  @@index([priority])
  @@index([dueDate])
  @@index([completed])
  @@index([status])
}

model TodoMention {
  id          String   @id @default(uuid())
  todoId      String
  todo        Todo     @relation("TodoMentions", fields: [todoId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation("MentionedEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  mentionedAt DateTime @default(now())

  @@unique([todoId, employeeId])
  @@index([employeeId])
  @@index([todoId])
}

model TodoUpdate {
  id          String   @id @default(uuid())
  todoId      String
  todo        Todo     @relation("TodoUpdates", fields: [todoId], references: [id], onDelete: Cascade)
  description String
  updateType  String   // "comment", "status_change", "assignment", "mention_added", "mention_removed"
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  @@index([todoId])
  @@index([createdAt])
}

model PurchaseOrder {
  id                          String           @id @default(uuid())
  gstNo                       String?
  customerId                  String?
  customer                    Customer?        @relation(fields: [customerId], references: [id])
  assignedToEmployeeId        String?
  assignedToEmployee          Employee?        @relation("PurchaseOrderAssignedTo", fields: [assignedToEmployeeId], references: [id])
  assignedAt                  DateTime?
  poNo                        String?          @default(uuid())
  poDate                      DateTime?
  dispatchDate                DateTime?
  brandName                   String?
  partyName                   String?
  batchNo                     String?
  paymentTerms                String?
  invCha                      String?
  cylChar                     String?
  orderThrough                String?
  address                     String?
  composition                 String?
  compositionId               String?
  compositionMaster           CompositionMaster? @relation(fields: [compositionId], references: [id], onDelete: SetNull)
  notes                       String?
  rmStatus                    String?
  poQty                       String?
  poRate                       String?
  amount                       String?
  mrp                         String?
  section                      String?
  specialRequirements          String?
  tabletCapsuleDrySyrupBottle String?
  roundOvalTablet              String?
  tabletColour                 String?
  aluAluBlisterStripBottle     String?
  packStyle                    String?
  productNewOld                String?
  qaObservations               String?
  batchQty                     String?
  expiry                       DateTime?
  pvcColourBase                String?
  foil                         String?
  lotNo                        String?
  foilPoDate                   DateTime?
  foilSize                     String?
  foilPoVendor                 String?
  foilBillDate                 DateTime?
  foilQuantity                 String?
  cartonPoDate                 DateTime?
  cartonPoVendor               String?
  cartonBillDate               DateTime?
  cartonQuantity               String?
  packingDate                  DateTime?
  qtyPacked                    String?
  noOfShippers                 String?
  design                       String?
  productionStatus             String?         // Status during production/manufacturing
  overallStatus                String           @default("Pending")
  invoiceNo                    String?
  invoiceDate                  DateTime?
  changePart                   String?
  cyc                          String?
  advance                      String?
  cycChargesQuantity           String?
  companyChargesQuantity       String?
  clientPayableCharges         String?
  showStatus                   String           @default("Order Pending")
  mdApproval                   String           @default("Pending")
  accountsApproval             String           @default("Pending")
  designerApproval             String           @default("Pending")
  ppicApproval                 String           @default("Pending")
  designerActions              Json?
  accountBills                 Json?
  salesComments                String?
  poDisputes                   Json?
  rawImportedData              Json?           // JSON field for unmapped sheet columns

  // NEW FIELDS
  foilQuantityOrdered          String?
  cartonQuantityOrdered        String?
  dispatchStatus               String?         @default("Pending")
  timestamp                    Json?           // JSON field for RM / Production / Dispatch statuses + timestamps
  statusHistory                PurchaseOrderStatusHistory[]
  assignmentHistory            PurchaseOrderAssignmentHistory[]
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  @@index([gstNo])
  @@index([customerId])
  @@index([compositionId])
  @@index([assignedToEmployeeId])
  @@index([poDate])
  @@index([overallStatus])
  @@index([createdAt])
}

model PurchaseOrderStatusHistory {
  id              String   @id @default(uuid())

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  status           String
  remarks          String?
  changedBy        String?
  metadata         Json?

  createdAt        DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([status])
}

model PurchaseOrderAssignmentHistory {
  id                   String   @id @default(uuid())
  purchaseOrderId      String
  purchaseOrder        PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  assignedToEmployeeId String?
  assignedByEmployeeId String
  assignedByEmployee   Employee @relation("PurchaseOrderAssignedBy", fields: [assignedByEmployeeId], references: [id])
  previousEmployeeId   String?
  reason               String?
  remarks              String?
  assignedAt           DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([assignedToEmployeeId])
  @@index([assignedAt])
}

model ProformaInvoice {
  id                       String                           @id @default(uuid())
  piNo                     String?                          @unique
  piDate                   DateTime?
  customerId               String
  customer                 Customer                         @relation(fields: [customerId], references: [id])
  
  // Customer & Shipping Info
  brandName                String?
  partyName                String?
  gstNo                    String?
  address                  String?
  section                  String?
  
  // Transport Details
  transporter              String?
  destination              String?
  modeOfTransport          String?
  courier                  String?
  
  // Composition & Line Items
  composition              String?
  compositionId            String?
  compositionMaster        CompositionMaster?               @relation(fields: [compositionId], references: [id], onDelete: SetNull)
  lineItems                ProformaInvoiceLineItem[]
  
  // Legacy single item fields (for compatibility)
  piQty                    String?
  piRate                   String?
  amount                   String?
  mrp                      String?
  
  // Financial Details
  paymentTerms             String?
  deliveryTerms            String?
  subtotal                 String?
  gstAmount                String?
  grandTotal               String?
  advance                  String?
  notes                    String?
  
  // CYC Charges Details
  cycChargesQuantity       String?
  companyChargesQuantity   String?
  clientPayableCharges     String?
  
  // Packing Details
  packStyle                String?
  packType                 String?
  formType                 String?
  numberOfShippers         String?
  productType              String?
  
  // Order Type
  orderType                String?                          @default("NEW")
  
  // Approval Workflow
  preparedByEmployeeId     String?
  preparedBy               Employee?                        @relation("PI_PreparedBy", fields: [preparedByEmployeeId], references: [id])
  checkedByEmployeeId      String?
  checkedBy                Employee?                        @relation("PI_CheckedBy", fields: [checkedByEmployeeId], references: [id])
  accountantEmployeeId     String?
  accountant               Employee?                        @relation("PI_Accountant", fields: [accountantEmployeeId], references: [id])
  designerEmployeeId       String?
  designer                 Employee?                        @relation("PI_Designer", fields: [designerEmployeeId], references: [id])
  authorisedByEmployeeId   String?
  authorisedBy             Employee?                        @relation("PI_AuthorisedBy", fields: [authorisedByEmployeeId], references: [id])
  
  // Bank Details
  bankDetails              Json?
  termsAndConditions       Json?
  
  // Status & Verification
  status                   ProformaInvoiceStatus            @default(Draft)
  verificationStatus       String                           @default("Pending")
  verifiedBy               String?
  verifiedAt               DateTime?
  rejectionReason          String?
  
  // PDF & Conversion
  pdfUrl                   String?
  pdfFileName              String?
  
  convertedToPOId          String?
  convertedAt              DateTime?
  convertedBy              String?
  
  createdBy                String
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  
  @@index([customerId])
  @@index([compositionId])
  @@index([status])
  @@index([verificationStatus])
  @@index([piDate])
  @@index([createdAt])
  @@index([piNo])
}

model ProformaInvoiceLineItem {
  id                       String                  @id @default(uuid())
  piId                     String
  proformaInvoice          ProformaInvoice         @relation(fields: [piId], references: [id], onDelete: Cascade)
  
  itemNo                   Int
  brandName                String?
  composition              String?
  compositionId            String?
  compositionMaster        CompositionMaster?      @relation(fields: [compositionId], references: [id], onDelete: SetNull)
  
  orderType                String?
  packing                  String?
  section                  String?
  
  qty                      String?
  mrp                      String?
  rate                     String?
  amount                   String?
  gst                      String?
  
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  
  @@index([piId])
  @@unique([piId, itemNo])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AuditLog {
  id          String   @id @default(uuid())
  action      String
  performedBy String
  targetId    String
  details     Json?
  timestamp   DateTime @default(now())

  @@map("audit_logs")
}



model ChangePartMaster {
  id                     String   @id @default(uuid())
  partPictureUrl         String?          
  code                   String?          
  boxSizeAutoCalculated  String?         
  cartonRates            Decimal?         
  baseFoilConsumption    Decimal?         
  printedFoilConsumption Decimal?         
  tabSize                String?          
  range                  String?          
  foilSize               String?          
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}


enum CompositionSource {
  PPIC_BULK_IMPORT
  COMPOSITION_BULK_IMPORT
  MANUAL
}

model CompositionMaster {
  id                   String                  @id @default(uuid())
  composition          String? 
  formType             String? 
  packingType          String? 
  layerType            String? 
  color                String? 
  flavor               String? 
  coating              String? 
  changePartOptions    String[]                @default([])  // fixed
  shelfLifeMonths      Int? 
  review               String? 
  source               CompositionSource       @default(MANUAL)
  purchaseOrders       PurchaseOrder[]         @relation()
  proformaInvoices     ProformaInvoice[]
  proformaLineItems    ProformaInvoiceLineItem[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  
  @@index([composition])
  @@index([source])
}



model ApiMaster {
  id                   String   @id @default(uuid())
  drugName             String
  drugQuantity         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}


model VendorMaster{
    id                   String   @id @default(uuid())
    vendorName           String
    vendorCode           String?
    contactPerson        String?
    vendorEmail          String?
    vendorPhone          String?
    vendorAdress         String?
    vendorState          String?
    vendorGSTNo          String?
    paymentTerms         String?
    vendorBankName       String?
    vendorAccountNumber  String?
    vendorIFSC           String?
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

}

// ============ HR MODULE MODELS ============

model LeaveRequest {
  id                   String       @id @default(uuid())
  employeeId           String
  employee             Employee     @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType            LeaveType
  startDate            DateTime
  endDate              DateTime
  numberOfDays         Int
    requestedBy     String?
  reason               String?
  status               LeaveStatus  @default(Pending)
  approverEmployeeId   String?
  approverEmployee     Employee?    @relation("ApproverLeaveRequests", fields: [approverEmployeeId], references: [id], onDelete: SetNull)
  approverComments     String?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  rejectionReason      String?
  attachmentUrl        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([leaveType])
}

model Attendance {
  id                   String              @id @default(uuid())
  employeeId           String
  employee             Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate       DateTime
  status               AttendanceStatus    @default(Absent)
  checkInTime          DateTime?
  checkOutTime         DateTime?
  workingHours         Float?
  location             String?
  notes                String?
  deviceId             String?
  verifiedBy           String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([employeeId])
  @@index([attendanceDate])
  @@index([status])
}

model Payroll {
  id                      String          @id @default(uuid())
  employeeId              String
  employee                Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollMonth            DateTime
  baseSalary              Float
  housRentAllowance       Float           @default(0)
  conveyanceAllowance     Float           @default(0)
  medicalAllowance        Float           @default(0)
  specialAllowance        Float           @default(0)
  bonus                   Float           @default(0)
  otherAdditions          Float           @default(0)
  totalAdditions          Float
  
  incomeTax               Float           @default(0)
  providentFund           Float           @default(0)
  employeeStateInsurance  Float           @default(0)
  otherDeductions         Float           @default(0)
  totalDeductions         Float
  
  netSalary               Float
  status                  PayrollStatus   @default(Draft)
  approvedBy              String?
  approvedAt              DateTime?
  remarks                 String?
  pdfUrl                  String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([employeeId])
  @@index([payrollMonth])
  @@index([status])
}

model EmployeeDocument {
  id                  String          @id @default(uuid())
  employeeId          String
  employee            Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType        DocumentType
  documentName        String
  documentNumber      String?
  fileUrl             String
  expiryDate          DateTime?
  issueDate           DateTime?
  issuingAuthority    String?
  extractedData       Json?           // Stores PDF extracted data
  verificationStatus  String          @default("Pending")
  verifiedBy          String?
  verifiedAt          DateTime?
  remarks             String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([employeeId])
  @@index([documentType])
  @@index([verificationStatus])
}

model PerformanceReview {
  id                    String               @id @default(uuid())
  revieweeId            String
  reviewee              Employee             @relation("RevieweePerformance", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewerId            String
  reviewer              Employee             @relation("ReviewerPerformance", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewPeriodStart     DateTime
  reviewPeriodEnd       DateTime
  overallRating         PerformanceRating
  
  // Performance Criteria Ratings
  technicalSkills       PerformanceRating?
  communication         PerformanceRating?
  teamwork              PerformanceRating?
  leadership            PerformanceRating?
  reliability           PerformanceRating?
  innovation            PerformanceRating?
  
  achievements          String?
  areasOfImprovement    String?
  feedback              String?
  goals                 String?
  developmentPlan       String?
  
  acknowledgedAt        DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([revieweeId])
  @@index([reviewerId])
  @@index([reviewPeriodStart])
}

model EmployeeBenefit {
  id                    String          @id @default(uuid())
  employeeId            String
  employee              Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  benefitName           String
  benefitDescription    String?
  benefitType           String          // Health, Retirement, Insurance, etc.
  enrollmentDate        DateTime
  expiryDate            DateTime?
  benefitAmount         Float?
  provider              String?
  policyNumber          String?
  documentUrl           String?
  status                String          @default("Active")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([employeeId])
  @@index([benefitType])
}

model Grievance {
  id                      String          @id @default(uuid())
  employeeId              String
  employee                Employee        @relation("EmployeeGrievance", fields: [employeeId], references: [id], onDelete: Cascade)
  grievanceType           String          // Harassment, Discrimination, Unfair Treatment, etc.
  description             String
  dateOfIncident          DateTime
  submittedDate           DateTime        @default(now())
  status                  GrievanceStatus @default(Filed)
  assignedToId            String?
  assignedTo              Employee?       @relation("AssignedToGrievance", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  investigationNotes      String?
  resolution              String?
  resolutionDate          DateTime?
  followUpRequired        Boolean         @default(false)
  followUpDate            DateTime?
  
  attachments             Json?           // Array of attachment URLs
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([grievanceType])
}

model EmployeeShift {
  id                    String          @id @default(uuid())
  employeeId            String
  employee              Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftType             ShiftType       @default(Day)
  startTime             DateTime?
  endTime               DateTime?
  effectiveFrom         DateTime
  effectiveUntil        DateTime?
  breakDuration         Int?            // in minutes
  rotationPattern       String?         // Weekly, Bi-weekly, Monthly
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([employeeId])
  @@index([shiftType])
}

model EmployeeTraining {
  id                    String          @id @default(uuid())
  employeeId            String
  employee              Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trainingName          String
  trainingProvider      String?
  startDate             DateTime
  endDate               DateTime?
  duration              Int?            // in hours
  skillsAcquired        String?
  certificateUrl        String?
  cost                  Float?
  status                String          @default("Scheduled")
  completionDate        DateTime?
  assessmentScore       Float?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([employeeId])
  @@index([startDate])
}

model Designation {
  id                    String          @id @default(uuid())
  name                  String          @unique
  description           String?
  department            String
  reportingTo           String?
  baseSalaryRange       String?
  skills                String[]        @default([])
  status                String          @default("Active")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([department])
}

model Department {
  id                    String          @id @default(uuid())
  name                  String          @unique
  code                  String?         @unique
  description           String?
  headOfDepartment      String?
  budget                Float?
  status                String          @default("Active")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

// ============ SECURITY & LOGIN TRACKING ============

enum LoginAttemptStatus {
  Success
  Failed
  Blocked
}

model LoginAttempt {
  id                String            @id @default(uuid())
  username          String            // Username attempted to login
  email             String?           // Employee email if found
  employeeId        String?           // Employee ID if successful
  employee          Employee?         @relation("LoginAttempts", fields: [employeeId], references: [id], onDelete: SetNull)
  ipAddress         String            // IP address of the attempt
  userAgent         String?           // Browser/device information
  status            LoginAttemptStatus @default(Failed)
  failureReason     String?           // Why login failed (wrong password, account locked, etc)
  deviceInfo        Json?             // Stored device fingerprint/info
  location          String?           // Geo-location if available
  latitude          Float?
  longitude         Float?
  timestamp         DateTime          @default(now())
  sessionId         String?           // Session ID if successful
  
  @@index([username])
  @@index([employeeId])
  @@index([ipAddress])
  @@index([status])
  @@index([timestamp])
  @@index([email])
}

model BlockedIP {
  id                String            @id @default(uuid())
  ipAddress         String            @unique
  reason            String?           // Why the IP was blocked
  blockedBy         String            // Admin who blocked it
  autoBlocked       Boolean           @default(false) // Whether it was auto-blocked by system
  attemptCount      Int               @default(0) // Number of failed attempts before blocking
  blockedAt         DateTime          @default(now())
  unblockedAt       DateTime?
  isActive          Boolean           @default(true)
  notes             String?
  
  @@index([ipAddress])
  @@index([isActive])
  @@index([blockedAt])
}

model SecurityPolicy {
  id                              String            @id @default(uuid())
  name                            String            @unique
  maxLoginAttemptsPerIp           Int               @default(5) // Max failed attempts per IP before blocking
  maxLoginAttemptsPerUsername     Int               @default(10) // Max failed attempts per username before locking account
  loginAttemptWindowMinutes       Int               @default(15) // Time window for counting attempts
  accountLockoutDurationMinutes   Int               @default(30) // Duration account remains locked after max attempts
  ipBlockDurationMinutes          Int               @default(60) // Duration IP remains blocked after max attempts
  requireMfa                      Boolean           @default(false) // Multi-factor authentication
  requireStrongPassword           Boolean           @default(true)
  passwordMinLength               Int               @default(8)
  passwordRequireNumbers          Boolean           @default(true)
  passwordRequireSpecialChars     Boolean           @default(true)
  passwordRequireUpperCase        Boolean           @default(true)
  passwordExpiryDays              Int               @default(90)
  sessionTimeoutMinutes           Int               @default(30)
  enableIpWhitelisting            Boolean           @default(false)
  enableGeoRestriction            Boolean           @default(false)
  allowedCountries                String[]          @default([]) // ISO country codes
  suspiciousActivityAlert         Boolean           @default(true)
  logAllAttempts                  Boolean           @default(true)
  enableAnomalyDetection          Boolean           @default(true)
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  
  @@index([name])
}

model AccountLockout {
  id                String            @id @default(uuid())
  employeeId        String            @unique
  employee          Employee?         @relation("AccountLockouts", fields: [employeeId], references: [id], onDelete: Cascade)
  lockedAt          DateTime          @default(now())
  lockedUntil       DateTime
  reason            String            // Reason for lockout
  failedAttempts    Int               // Number of failed attempts
  unlockToken       String?           // Token to unlock account via email
  unlockedAt        DateTime?
  unlockedBy        String?           // Admin who unlocked or "auto" if self-unlocked
  
  @@index([employeeId])
  @@index([lockedUntil])
  @@index([unlockedAt])
}

model SecurityAuditLog {
  id                String            @id @default(uuid())
  employeeId        String?           // Employee involved (if applicable)
  employee          Employee?         @relation("SecurityAuditLogs", fields: [employeeId], references: [id], onDelete: SetNull)
  action            String            // LOGIN_ATTEMPT, IP_BLOCKED, ACCOUNT_LOCKED, MFA_ENABLED, etc
  ipAddress         String?
  userAgent         String?
  severity          String            @default("Info") // Info, Warning, Critical
  description       String
  metadata          Json?             // Additional info about the event
  timestamp         DateTime          @default(now())
  
  @@index([employeeId])
  @@index([action])
  @@index([severity])
  @@index([timestamp])
  @@index([ipAddress])
}

model NavbarPermission {
  id                String            @id @default(uuid())
  employeeId        String            @unique
  employee          Employee          @relation("NavbarPermissions", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeName      String
  email             String?
  allowedMenuItems  String[]          // Array of menu item IDs/names
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index([employeeId])
  @@index([createdAt])
}

// ============ MAINTENANCE & ASSETS MODULE ============

enum MachineStatus {
  Operational
  UnderMaintenance
  Breakdown
  Inactive
  Reserved
}

enum MaintenanceType {
  Preventive
  Corrective
  Predictive
  Emergency
}

enum MaintenanceStatus {
  Scheduled
  InProgress
  OnHold
  Completed
  Cancelled
}

enum PartStatus {
  Available
  OutOfStock
  OnOrder
  Damaged
  Obsolete
}

enum BrokenPartDisposition {
  Scrapped
  InStorage
  ReturnedToVendor
  RepairInProgress
  Sold
  Recycled
}

// Machine Type - Categorization of machines
model MachineType {
  id                    String          @id @default(uuid())
  name                  String          @unique // e.g., "Tablet Press", "Capsule Filling", "Mixer"
  code                  String          @unique
  description           String?
  category              String          // e.g., "Production", "Utility", "Support"
  manufacturer          String?
  modelNumber           String?
  capacity              String?
  powerRequirement      String?
  maintenanceFrequency  String?         // e.g., "Monthly", "Quarterly"
  averageLifespan       String?
  customFields          Json?           // Dynamic field structure: {fieldName: {type, required, default}}
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  machines              Machine[]
  
  @@index([category])
  @@index([isActive])
}

// Machine - Core machine/asset tracking
model Machine {
  id                        String              @id @default(uuid())
  name                      String              // e.g., "Tablet Press - A1"
  code                      String
  machineTypeId             String
  machineType               MachineType         @relation(fields: [machineTypeId], references: [id], onDelete: Restrict)
  serialNumber              String              @unique
  location                  String
  capacity                  String?
  supplier                  String
  department                String?
  status                    MachineStatus       @default(Operational)
  
  // Asset Information
  purchaseDate              DateTime?
  purchasePrice             Float?
  warrantyExpiry            DateTime?
  depreciation              Float?              // Percentage per year
  
  // Operational Details
  installationDate          DateTime?
  lastMaintenanceDate       DateTime?
  nextScheduledMaintenance  DateTime?
  operatingHours            Float?              @default(0)
  hoursPerDay               Float?
  utilizationRate           Float?              // Percentage
  
  // Additional Info
  documentation             String?             // URL/path to manuals
  contacts                  Json?               // {vendor: {name, phone, email}}
  powerRequirement          String?
  spaceRequired             String?
  
  // Dynamic fields (stored as JSON, structure defined in MachineType)
  customFields              Json?
  
  // Relations
  maintenanceRecords        MaintenanceRecord[]
  sparePartsAssigned        MachineSparePart[]
  currentStatus             MachineCurrentStatus? @relation("MachineCurrentStatus")
  assignedToEmployeeId      String?
  assignedToEmployee        Employee?           @relation("MaintenanceMachineAssignedTo", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  
  createdBy                 String
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  
  @@index([machineTypeId])
  @@index([location])
  @@index([department])
  @@index([status])
  @@index([lastMaintenanceDate])
  @@index([nextScheduledMaintenance])
}

// Real-time machine status tracking
model MachineCurrentStatus {
  id                    String          @id @default(uuid())
  machineId             String          @unique
  machine               Machine         @relation("MachineCurrentStatus", fields: [machineId], references: [id], onDelete: Cascade)
  
  currentStatus         MachineStatus   @default(Operational)
  statusChangedAt       DateTime        @default(now())
  usedInProduction      Boolean         @default(false)
  productionLineId      String?
  currentActivity       String?         // e.g., "Running Production PO-123", "In Maintenance", "Under Repair"
  operatorEmployeeId    String?
  maintainerEmployeeId  String?
  estimatedDowntimeEnd  DateTime?
  
  updatedAt             DateTime        @updatedAt
  
  @@index([machineId])
  @@index([currentStatus])
  @@index([usedInProduction])
}

// Maintenance Records
model MaintenanceRecord {
  id                        String              @id @default(uuid())
  machineId                 String
  machine                   Machine             @relation(fields: [machineId], references: [id], onDelete: Cascade)
  
  maintenanceType           MaintenanceType     @default(Preventive)
  status                    MaintenanceStatus   @default(Scheduled)
  
  scheduledDate             DateTime
  startDate                 DateTime?
  completionDate            DateTime?
  
  description               String
  findings                  String?             // What was found/inspected
  workDone                  String?             // What maintenance was performed
  
  assignedToEmployeeId      String?
  assignedToEmployee        Employee?           @relation("MaintenanceRecordAssignedTo", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  
  // Tracking
  partsUsed                 MaintenancePartUsage[]
  estimatedDurationHours    Int?
  actualDurationHours       Int?
  downtime                  Int?                // In minutes
  
  // Cost tracking
  laborCost                 Float?
  materialCost              Float?
  totalCost                 Float?
  
  nextMaintenanceDate       DateTime?
  brokenParts               BrokenPart[]
  notes                     String?
  attachments               Json?               // URLs to images/documents
  
  createdBy                 String
  verifiedBy                String?
  
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  
  @@index([machineId])
  @@index([status])
  @@index([scheduledDate])
  @@index([completionDate])
  @@index([assignedToEmployeeId])
}

// Part/Spare Part Master
model Part {
  id                    String          @id @default(uuid())
  name                  String
  code                  String          @unique
  description           String?
  category              String          // e.g., "Bearing", "Seal", "Motor", "Bearing"
  partNumber            String?         @unique
  manufacturer          String?
  supplierIds           String[]        // Array of supplier IDs
  
  // Inventory
  quantityInStock       Int             @default(0)
  minimumStock          Int             @default(5)
  reorderPoint          Int             @default(10)
  reorderQuantity       Int             @default(20)
  
  // Cost
  unitCost              Float?
  sellingPrice          Float?
  lastPriceUpdate       DateTime?
  
  // Standards
  status                PartStatus      @default(Available)
  acceptableAlternatives String[]       // IDs of alternative parts
  compatibility         Json?           // {machineTypeIds: [...]}
  
  // Tracking
  usageHistory          MaintenancePartUsage[]
  orders                PartOrder[]
  brokenParts           BrokenPart[]
  
  usedInMachines        MachineSparePart[]
  
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  
  @@index([category])
  @@index([status])
  @@index([code])
}

// Machine Spare Parts - Assignment of parts to machines
model MachineSparePart {
  id                    String          @id @default(uuid())
  machineId             String
  machine               Machine         @relation(fields: [machineId], references: [id], onDelete: Cascade)
  partId                String
  part                  Part            @relation(fields: [partId], references: [id], onDelete: Restrict)
  
  quantityRequired      Int
  criticality           String          @default("Medium") // High, Medium, Low
  lastReplacedDate      DateTime?
  replacementCycle      Int?           // In days
  notes                 String?
  
  @@unique([machineId, partId])
  @@index([machineId])
  @@index([partId])
}

// Maintenance Part Usage Tracking
model MaintenancePartUsage {
  id                    String          @id @default(uuid())
  maintenanceRecordId   String
  maintenanceRecord     MaintenanceRecord @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  
  partId                String
  part                  Part            @relation(fields: [partId], references: [id], onDelete: Restrict)
  
  quantityUsed          Int
  unitCost              Float?
  totalCost             Float?
  costCenter            String?
  
  @@index([maintenanceRecordId])
  @@index([partId])
}

// Part Orders - Tracking incoming parts
model PartOrder {
  id                    String          @id @default(uuid())
  orderNumber           String          @unique
  partId                String
  part                  Part            @relation(fields: [partId], references: [id], onDelete: Restrict)
  
  supplierId            String
  supplierName          String
  supplierContact       String?
  supplierPhone         String?
  
  quantity              Int
  unitPrice             Float?
  totalPrice            Float?
  
  orderDate             DateTime        @default(now())
  expectedDelivery      DateTime?
  actualDelivery        DateTime?
  deliveryStatus        String          @default("Pending") // Pending, Delivered, Delayed, Cancelled
  
  purchaseOrderNumber   String?
  paymentStatus         String          @default("Unpaid") // Unpaid, Paid, Partial
  amountPaid            Float?          @default(0)
  
  notes                 String?
  attachments           Json?           // Invoice, PO, etc
  
  orderedBy             String
  
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  
  @@index([partId])
  @@index([orderDate])
  @@index([expectedDelivery])
  @@index([deliveryStatus])
}

// Broken Parts Tracking
model BrokenPart {
  id                    String              @id @default(uuid())
  maintenanceRecordId   String
  maintenanceRecord     MaintenanceRecord   @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  
  partId                String?
  part                  Part?               @relation(fields: [partId], references: [id], onDelete: SetNull)
  
  partName              String              // In case part is not in master
  originalQuantity      Int
  
  disposition           BrokenPartDisposition @default(InStorage)
  dispositionDate       DateTime?
  dispositionNotes      String?
  
  // If Scrapped
  scrapReason           String?
  scrapApprovedBy       String?
  
  // If In Storage
  storageLocation       String?
  
  // If Returned
  vendorReturnId        String?
  returnAuthorization   String?
  returnDate            DateTime?
  
  // If Sold/Recycled
  salePrice             Float?
  buyerId               String?
  saleDateFor          DateTime?
  
  status                String              @default("Pending") // Pending, Approved, Disposed
  approvedBy            String?
  approvalDate          DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  @@index([maintenanceRecordId])
  @@index([disposition])
  @@index([status])
}

// Fixed Assets - Spare equipment and tools
model FixedAsset {
  id                    String          @id @default(uuid())
  name                  String          // e.g., "Drill Machine", "Spare Motor", "LED Work Light"
  code                  String          @unique
  assetCategory         String          // e.g., "Equipment", "Tools", "Spare Parts", "Consumables"
  description           String?
  
  manufacturer          String?
  modelNumber           String?
  serialNumber          String?         @unique
  
  // Location & Inventory
  currentLocation       String          // Warehouse location
  quantity              Int             @default(1)
  minThreshold          Int             @default(1)
  
  // Asset Details
  purchaseDate          DateTime?
  purchasePrice         Float?
  currentValue          Float?
  depreciation          Float?          // Percentage per year
  warrantyExpiry        DateTime?
  
  supplier              String?
  supplierContact       String?
  
  // Usage
  status                String          @default("Available") // Available, InUse, Reserved, Damaged, Obsolete
  assignedToEmployeeId  String?
  assignedToEmployee    Employee?       @relation("FixedAssetAssignedTo", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  assignedDate          DateTime?
  lastUsedDate          DateTime?
  
  usageHistory          FixedAssetUsageLog[]
  
  // Maintenance
  maintenanceRequired   Boolean         @default(false)
  lastMaintenanceDate   DateTime?
  nextMaintenanceDate   DateTime?
  
  documentation         String?
  condition             String          @default("Good") // Good, Fair, Poor
  notes                 String?
  attachments           Json?
  
  createdBy             String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  
  @@index([assetCategory])
  @@index([status])
  @@index([currentLocation])
  @@index([assignedToEmployeeId])
}

// Fixed Asset Usage Log
model FixedAssetUsageLog {
  id                    String          @id @default(uuid())
  assetId               String
  asset                 FixedAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  usedByEmployeeId      String?
  usedBy                String?         // Employee name or description
  usedForMachineId      String?         // Which machine it was used on
  usedForDescription    String?
  
  checkOutDate          DateTime        @default(now())
  checkInDate           DateTime?
  duration              Int?            // In hours
  
  condition             String?         // Condition when returned
  notes                 String?
  
  @@index([assetId])
  @@index([checkOutDate])
}

