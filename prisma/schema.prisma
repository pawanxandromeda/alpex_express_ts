// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  
}

generator client {
  provider = "prisma-client-js"
}

enum Status {
  Active
  Inactive
}

enum ShiftType {
  Day
  Night
  Rotational
}

enum TodoPriority {
  Low
  Medium
  High
  Urgent
}

enum TodoStatus {
  Open
  InProgress
  OnHold
  Completed
  Cancelled
}

enum LeadStatus {
  New
  Contacted
  Interested
  Qualified
  Converted
  Lost
  OnHold
}

enum FollowUpStatus {
  Pending
  Completed
  Rescheduled
}

enum EmployeeStatus {
  Pending
  Active
  Inactive
}

enum CredentialApprovalStatus {
  Pending
  Approved
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
  Cancelled
}

enum LeaveType {
  Sick
  Casual
  Earned
  Maternity
  Paternity
  Unpaid
  Special
  Bereavement
  Marriage
  Study
}

enum AttendanceStatus {
  Present
  Absent
  Leave
  HalfDay
  WFH
  Holidays
  WeekOff
}

enum PayrollStatus {
  Draft
  Submitted
  Approved
  Processed
  Paid
  Rejected
}

enum PerformanceRating {
  Outstanding
  Exceeds
  Meets
  Developing
  Unsatisfactory
}

enum GrievanceStatus {
  Filed
  UnderReview
  InProgress
  Resolved
  Closed
  Withdrawn
}

enum DocumentType {
  Aadhar
  PAN
  DrivingLicense
  Passport
  EducationCertificate
  ExperienceCertificate
  MedicalReport
  Other
}

model Employee {
  id                     String                   @id @default(uuid())
  name                   String
  email                  String                   @unique
  phone                  String                   @unique
  role                   String
  department             String
  status                 EmployeeStatus           @default(Pending)
  approvedForCredentials CredentialApprovalStatus @default(Pending)

  dateOfJoining          DateTime?
  dateOfBirth            DateTime?
  ctc                    Float?
  baseSalary             Float?
  fatherName             String?
  motherName             String?
  spouseName             String?
  permanentAddress       String?
  currentAddress         String?
  bloodGroup             String?
  emergencyContact       String?
  emergencyContactPhone  String?
  
  // HR Extended Fields
  designation            String?
  reportingManagerId     String?
  reportingManager       Employee?  @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates           Employee[] @relation("ReportingManager")
  bankName               String?
  bankAccountNumber      String?
  bankIfscCode           String?
  panNumber              String?
  aadharNumber           String?
  esi                    String?
  pf                     String?
  totalLeaveBalance      Int?       @default(0)
  usedLeave              Int?       @default(0)
  
  createdCustomers       Customer[]
  createdByRole          String
  username               String?                  @unique
  password               String?
  approvedBy             String?
  approvedAt             DateTime?
  rejectionReason        String?
  refreshToken           String?

  createdTodos           Todo[]                   @relation("CreatedTodos")
  assignedTodos          Todo[]                   @relation("AssignedTodos")
  mentionedInTodos       TodoMention[]            @relation("MentionedEmployee")
  assignedLeads          Lead[]                   @relation("AssignedLeads")
  adminAssignedLeads     Lead[]                   @relation("AdminAssignedLeads")
  leadFollowUps          LeadFollowUp[]           @relation("LeadFollowUps")
  
  // HR Relations
  leaveRequests          LeaveRequest[]           @relation("EmployeeLeaveRequests")
  approverLeaveRequests  LeaveRequest[]           @relation("ApproverLeaveRequests")
  attendanceRecords      Attendance[]
  payrollRecords         Payroll[]
  documents              EmployeeDocument[]
  performanceReviews     PerformanceReview[]      @relation("RevieweePerformance")
  givenReviews           PerformanceReview[]      @relation("ReviewerPerformance")
  employeeBenefits       EmployeeBenefit[]
  grievances             Grievance[]              @relation("EmployeeGrievance")
  grievanceAssignedTo    Grievance[]              @relation("AssignedToGrievance")
  shifts                 EmployeeShift[]
  trainingPrograms       EmployeeTraining[]

  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  
  @@index([department])
  @@index([status])
  @@index([reportingManagerId])
}


model Customer {
  id                   String   @id @default(uuid())
  customerName         String
  address              String?
  creditLimit          Float    @default(0)
  creditApprovalStatus String   @default("Pending")
  paymentTerms         String
  throughVia           String?
  gstrNo               String   @unique
    createdByEmployeeId  String?
  createdByEmployee    Employee? @relation(fields: [createdByEmployeeId], references: [id])
  kycProfile           String?
  contactName          String?
  contactPhone         String?
  contactEmail         String?
  contacts             Json?
  remarks              String?
  relationshipStatus   String?
  gstCopy              String?
  drugLicense         String?   // License number (string)
  dlExpiry             DateTime? // Expiry date (DateTime)
  isBlacklisted        Boolean  @default(false)
  blacklistReason      String?
  promotor             String?
  blacklistedAt        DateTime?
  purchaseOrders       PurchaseOrder[]
  leads                Lead[]
  annualTurnover       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Lead {
  id                   String      @id @default(uuid())
  customerId           String
  customer             Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedToEmployeeId String?
  assignedToEmployee   Employee?   @relation("AssignedLeads", fields: [assignedToEmployeeId], references: [id])
  assignedByEmployeeId String
  assignedByEmployee   Employee    @relation("AdminAssignedLeads", fields: [assignedByEmployeeId], references: [id])
  status               LeadStatus  @default(New)
  followUps            LeadFollowUp[]
  notes                String?
  assignedAt           DateTime    @default(now())
  lastContactedAt      DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  assignmentHistory    LeadAssignmentHistory[]
  @@unique([customerId, assignedToEmployeeId])
}

model LeadAssignmentHistory {
  id                   String   @id @default(uuid())
  leadId               String
  lead                 Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToEmployeeId String?
  assignedByEmployeeId String
  assignedAt           DateTime @default(now())
  notes                String?
}

model LeadFollowUp {
  id                   String     @id @default(uuid())
  leadId               String
  lead                 Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee   @relation("LeadFollowUps", fields: [employeeId], references: [id])
  followUpType         String     // e.g., "Call", "Email", "Meeting", "Demo"
  notes                String?
  nextFollowUpDate     DateTime?
  status               FollowUpStatus @default(Pending)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Todo {
  id                String       @id @default(uuid())
  title             String
  description       String?
  priority          TodoPriority @default(Medium)
  status            TodoStatus   @default(Open)
  createdById       String
  createdBy         Employee     @relation("CreatedTodos", fields: [createdById], references: [id], onDelete: Cascade)
  assignedToId      String?
  assignedTo        Employee?    @relation("AssignedTodos", fields: [assignedToId], references: [id], onDelete: SetNull)
  mentionedEmployees TodoMention[] @relation("TodoMentions")
  updates           TodoUpdate[] @relation("TodoUpdates")
  completed         Boolean      @default(false)
  completedAt       DateTime?
  dueDate           DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([createdById])
  @@index([assignedToId])
  @@index([priority])
  @@index([dueDate])
  @@index([completed])
  @@index([status])
}

model TodoMention {
  id          String   @id @default(uuid())
  todoId      String
  todo        Todo     @relation("TodoMentions", fields: [todoId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation("MentionedEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  mentionedAt DateTime @default(now())

  @@unique([todoId, employeeId])
  @@index([employeeId])
  @@index([todoId])
}

model TodoUpdate {
  id          String   @id @default(uuid())
  todoId      String
  todo        Todo     @relation("TodoUpdates", fields: [todoId], references: [id], onDelete: Cascade)
  description String
  updateType  String   // "comment", "status_change", "assignment", "mention_added", "mention_removed"
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  @@index([todoId])
  @@index([createdAt])
}

model PurchaseOrder {
  id                          String           @id @default(uuid())
  gstNo                       String?
  customerId                  String?
  customer                    Customer?        @relation(fields: [customerId], references: [id])
  poNo                        String?          @default(uuid())
  poDate                      DateTime?
  dispatchDate                DateTime?
  brandName                   String?
  partyName                   String?
  batchNo                     String?
  paymentTerms                String?
  invCha                      String?
  cylChar                     String?
  orderThrough                String?
  address                     String?
  composition                 String?
  notes                       String?
  rmStatus                    String?
  poQty                       String?
  poRate                       String?
  amount                       String?
  mrp                         String?
  section                      String?
  specialRequirements          String?
  tabletCapsuleDrySyrupBottle String?
  roundOvalTablet              String?
  tabletColour                 String?
  aluAluBlisterStripBottle     String?
  packStyle                    String?
  productNewOld                String?
  qaObservations               String?
  batchQty                     String?
  expiry                       DateTime?
  pvcColourBase                String?
  foil                         String?
  lotNo                        String?
  foilPoDate                   DateTime?
  foilSize                     String?
  foilPoVendor                 String?
  foilBillDate                 DateTime?
  foilQuantity                 String?
  cartonPoDate                 DateTime?
  cartonPoVendor               String?
  cartonBillDate               DateTime?
  cartonQuantity               String?
  packingDate                  DateTime?
  qtyPacked                    String?
  noOfShippers                 String?
  design                       String?
  productionStatus             String?         // Status during production/manufacturing
  overallStatus                String           @default("Pending")
  invoiceNo                    String?
  invoiceDate                  DateTime?
  changePart                   String?
  cyc                          String?
  advance                      String?
  showStatus                   String           @default("Order Pending")
  mdApproval                   String           @default("Pending")
  accountsApproval             String           @default("Pending")
  designerApproval             String           @default("Pending")
  ppicApproval                 String           @default("Pending")
  designerActions              Json?
  accountBills                 Json?
  salesComments                String?
  poDisputes                   Json?
  rawImportedData              Json?           // JSON field for unmapped sheet columns

  // NEW FIELDS
  foilQuantityOrdered          String?
  cartonQuantityOrdered        String?
  dispatchStatus               String?         @default("Pending")
  timestamp                    Json?           // JSON field for RM / Production / Dispatch statuses + timestamps
 statusHistory   PurchaseOrderStatusHistory[]
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  @@index([gstNo])
  @@index([customerId])
  @@index([poDate])
  @@index([overallStatus])
  @@index([createdAt])
}

model PurchaseOrderStatusHistory {
  id              String   @id @default(uuid())

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  status           String
  remarks          String?
  changedBy        String?
  metadata         Json?

  createdAt        DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([status])
}




model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AuditLog {
  id          String   @id @default(uuid())
  action      String
  performedBy String
  targetId    String
  details     Json?
  timestamp   DateTime @default(now())

  @@map("audit_logs")
}



model ChangePartMaster {
  id                     String   @id @default(uuid())
  partPictureUrl         String?          
  code                   String?          
  boxSizeAutoCalculated  String?         
  cartonRates            Decimal?         
  baseFoilConsumption    Decimal?         
  printedFoilConsumption Decimal?         
  tabSize                String?          
  range                  String?          
  foilSize               String?          
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}


model CompositionMaster {
  id                   String   @id @default(uuid())
  composition          String? 
  formType             String? 
  packingType          String? 
  layerType            String? 
  color                String? 
  flavor               String? 
  coating              String? 
  changePartOptions    String[] @default([])  // fixed
  shelfLifeMonths      Int? 
  review               String? 
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}



model ApiMaster {
  id                   String   @id @default(uuid())
  drugName             String
  drugQuantity         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}


model VendorMaster{
    id                   String   @id @default(uuid())
    vendorName           String
    vendorCode           String?
    contactPerson        String?
    vendorEmail          String?
    vendorPhone          String?
    vendorAdress         String?
    vendorState          String?
    vendorGSTNo          String?
    paymentTerms         String?
    vendorBankName       String?
    vendorAccountNumber  String?
    vendorIFSC           String?
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

}

// ============ HR MODULE MODELS ============

model LeaveRequest {
  id                   String       @id @default(uuid())
  employeeId           String
  employee             Employee     @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType            LeaveType
  startDate            DateTime
  endDate              DateTime
  numberOfDays         Int
    requestedBy     String?
  reason               String?
  status               LeaveStatus  @default(Pending)
  approverEmployeeId   String?
  approverEmployee     Employee?    @relation("ApproverLeaveRequests", fields: [approverEmployeeId], references: [id], onDelete: SetNull)
  approverComments     String?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  rejectionReason      String?
  attachmentUrl        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([leaveType])
}

model Attendance {
  id                   String              @id @default(uuid())
  employeeId           String
  employee             Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate       DateTime
  status               AttendanceStatus    @default(Absent)
  checkInTime          DateTime?
  checkOutTime         DateTime?
  workingHours         Float?
  location             String?
  notes                String?
  deviceId             String?
  verifiedBy           String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([employeeId])
  @@index([attendanceDate])
  @@index([status])
}

model Payroll {
  id                      String          @id @default(uuid())
  employeeId              String
  employee                Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollMonth            DateTime
  baseSalary              Float
  housRentAllowance       Float           @default(0)
  conveyanceAllowance     Float           @default(0)
  medicalAllowance        Float           @default(0)
  specialAllowance        Float           @default(0)
  bonus                   Float           @default(0)
  otherAdditions          Float           @default(0)
  totalAdditions          Float
  
  incomeTax               Float           @default(0)
  providentFund           Float           @default(0)
  employeeStateInsurance  Float           @default(0)
  otherDeductions         Float           @default(0)
  totalDeductions         Float
  
  netSalary               Float
  status                  PayrollStatus   @default(Draft)
  approvedBy              String?
  approvedAt              DateTime?
  remarks                 String?
  pdfUrl                  String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([employeeId])
  @@index([payrollMonth])
  @@index([status])
}

model EmployeeDocument {
  id                  String          @id @default(uuid())
  employeeId          String
  employee            Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType        DocumentType
  documentName        String
  documentNumber      String?
  fileUrl             String
  expiryDate          DateTime?
  issueDate           DateTime?
  issuingAuthority    String?
  extractedData       Json?           // Stores PDF extracted data
  verificationStatus  String          @default("Pending")
  verifiedBy          String?
  verifiedAt          DateTime?
  remarks             String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([employeeId])
  @@index([documentType])
  @@index([verificationStatus])
}

model PerformanceReview {
  id                    String               @id @default(uuid())
  revieweeId            String
  reviewee              Employee             @relation("RevieweePerformance", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewerId            String
  reviewer              Employee             @relation("ReviewerPerformance", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewPeriodStart     DateTime
  reviewPeriodEnd       DateTime
  overallRating         PerformanceRating
  
  // Performance Criteria Ratings
  technicalSkills       PerformanceRating?
  communication         PerformanceRating?
  teamwork              PerformanceRating?
  leadership            PerformanceRating?
  reliability           PerformanceRating?
  innovation            PerformanceRating?
  
  achievements          String?
  areasOfImprovement    String?
  feedback              String?
  goals                 String?
  developmentPlan       String?
  
  acknowledgedAt        DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([revieweeId])
  @@index([reviewerId])
  @@index([reviewPeriodStart])
}

model EmployeeBenefit {
  id                    String          @id @default(uuid())
  employeeId            String
  employee              Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  benefitName           String
  benefitDescription    String?
  benefitType           String          // Health, Retirement, Insurance, etc.
  enrollmentDate        DateTime
  expiryDate            DateTime?
  benefitAmount         Float?
  provider              String?
  policyNumber          String?
  documentUrl           String?
  status                String          @default("Active")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([employeeId])
  @@index([benefitType])
}

model Grievance {
  id                      String          @id @default(uuid())
  employeeId              String
  employee                Employee        @relation("EmployeeGrievance", fields: [employeeId], references: [id], onDelete: Cascade)
  grievanceType           String          // Harassment, Discrimination, Unfair Treatment, etc.
  description             String
  dateOfIncident          DateTime
  submittedDate           DateTime        @default(now())
  status                  GrievanceStatus @default(Filed)
  assignedToId            String?
  assignedTo              Employee?       @relation("AssignedToGrievance", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  investigationNotes      String?
  resolution              String?
  resolutionDate          DateTime?
  followUpRequired        Boolean         @default(false)
  followUpDate            DateTime?
  
  attachments             Json?           // Array of attachment URLs
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([grievanceType])
}

model EmployeeShift {
  id                    String          @id @default(uuid())
  employeeId            String
  employee              Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftType             ShiftType       @default(Day)
  startTime             DateTime?
  endTime               DateTime?
  effectiveFrom         DateTime
  effectiveUntil        DateTime?
  breakDuration         Int?            // in minutes
  rotationPattern       String?         // Weekly, Bi-weekly, Monthly
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([employeeId])
  @@index([shiftType])
}

model EmployeeTraining {
  id                    String          @id @default(uuid())
  employeeId            String
  employee              Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trainingName          String
  trainingProvider      String?
  startDate             DateTime
  endDate               DateTime?
  duration              Int?            // in hours
  skillsAcquired        String?
  certificateUrl        String?
  cost                  Float?
  status                String          @default("Scheduled")
  completionDate        DateTime?
  assessmentScore       Float?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([employeeId])
  @@index([startDate])
}

model Designation {
  id                    String          @id @default(uuid())
  name                  String          @unique
  description           String?
  department            String
  reportingTo           String?
  baseSalaryRange       String?
  skills                String[]        @default([])
  status                String          @default("Active")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([department])
}

model Department {
  id                    String          @id @default(uuid())
  name                  String          @unique
  code                  String?         @unique
  description           String?
  headOfDepartment      String?
  budget                Float?
  status                String          @default("Active")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}